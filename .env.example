# Ollama 服务地址
OLLAMA_URL=http://localhost:11434

# 对话模型（需先 ollama pull）
# 推荐：deepseek-r1:7b / qwen2.5:7b / qwen2.5:14b
# 轻量：deepseek-r1:1.5b / qwen2.5:3b
CHAT_MODEL=deepseek-r1:7b

# 嵌入模型（需先 ollama pull）
# 推荐：bge-m3（中文最佳）
EMBED_MODEL=bge-m3

# RAG 参数
TOP_K=3
CHUNK_SIZE=400
OVERLAP=50
MAX_HISTORY_TURNS=3

# Web 服务
HOST=127.0.0.1
PORT=8000